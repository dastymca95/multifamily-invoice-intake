# ── Application ──────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-secrets-generate
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bills_user:bills_pass@localhost:5432/bills_db
DATABASE_SYNC_URL=postgresql://bills_user:bills_pass@localhost:5432/bills_db

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Storage ───────────────────────────────────────────────────
STORAGE_BACKEND=local          # local | s3
LOCAL_STORAGE_PATH=./storage/uploads

# S3-compatible (MinIO for local dev, AWS S3 for prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=bills
S3_REGION=us-east-1

# ── Extraction ────────────────────────────────────────────────
EXTRACTION_BACKEND=native_pdf  # native_pdf | ocr_stub | <future-provider>

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
